model ContractSaleCereal {
  id                        String             @id @default(uuid())
  accountId                 String
  account                   Account            @relation(fields: [accountId], references: [id])
  campaignId                String?
  campaign                  Campaign?          @relation(fields: [campaignId], references: [id])
  companyId                 String?
  company                   Company?           @relation(fields: [companyId], references: [id])
  cropId                    String?
  crop                      Crop?              @relation(fields: [cropId], references: [id])
  producerId                String?
  producer                  SocialEntity?      @relation("CSCProducer", fields: [producerId], references: [id])
  buyerId                   String?
  buyer                     SocialEntity?      @relation("CSCBuyer", fields: [buyerId], references: [id])
  destinationId             String?
  destination               OriginDestination? @relation(fields: [destinationId], references: [id])
  delivererId               String?
  deliverer                 SocialEntity?      @relation("CSCDeliverer", fields: [delivererId], references: [id])
  brokerId                  String?
  broker                    SocialEntity?      @relation("CSCBroker", fields: [brokerId], references: [id])
  commissionAgentId         String?
  commissionAgent           SocialEntity?      @relation("CSCCommission", fields: [commissionAgentId], references: [id])
  contractSaleNumber        String?
  brokerPercentage          Float?
  brokerAmountValue         Float?
  commissionAgentPercentage Float?
  commissionAgentAmountValue Float?
  condition                 String?
  paymentMethod             String?
  isOpenContract            Boolean            @default(false)
  dateCreated               DateTime?
  kg                        Float?
  kms                       Float?
  quintalQuote              Float?
  valueQuote                Float?
  usdQuote                  Float?
  valueUsdQuote             Float?
  currency                  CurrencyCode?
  amountValue               Float?
  kgDelivered               Float?
  valueCollected            Float?
  contractType              String?
  status                    String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  deliveryDates      ContractDeliveryDate[]
  transportDocuments TransportDocument[]

  @@map("contract_sale_cereals")
}

model ContractDeliveryDate {
  id           String             @id @default(uuid())
  contractId   String
  contract     ContractSaleCereal @relation(fields: [contractId], references: [id], onDelete: Cascade)
  deliveryDate DateTime?
  kg           Float?
  deliveredKg  Float?
  isCompleted  Boolean            @default(false)
  dateCreated  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@map("contract_delivery_dates")
}

model TransportDocument {
  id                      String              @id @default(uuid())
  accountId               String
  account                 Account             @relation(fields: [accountId], references: [id])
  campaignId              String?
  campaign                Campaign?           @relation(fields: [campaignId], references: [id])
  contractId              String?
  contract                ContractSaleCereal? @relation(fields: [contractId], references: [id])
  exitFieldId             String?
  exitField               ExitField?          @relation(fields: [exitFieldId], references: [id])
  vehicleChasisId         String?
  vehicleChasis           Vehicle?            @relation("TDChasis", fields: [vehicleChasisId], references: [id])
  vehicleTrailer1Id       String?
  vehicleTrailer1         Vehicle?            @relation("TDTrailer1", fields: [vehicleTrailer1Id], references: [id])
  vehicleTrailer2Id       String?
  vehicleTrailer2         Vehicle?            @relation("TDTrailer2", fields: [vehicleTrailer2Id], references: [id])
  billNumber              String?
  issueDate               DateTime?
  expirationDate          DateTime?
  ctgNumber               String?
  tariff                  Float?
  generatorTaxCode        String?
  estimatedKg             Float?
  grossKg                 Float?
  taraKg                  Float?
  netKg                   Float?
  transporterTaxCode      String?
  transporterBusinessName String?
  driverTaxCode           String?
  kmToTravel              Float?
  freightType             String?
  referenceRate           Float?
  departureDate           DateTime?
  contractSaleNumber      String?
  status                  String?
  fileName                String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  certificateLinks CertificateDepositTransport[]

  @@map("transport_documents")
}

model CertificateDeposit {
  id                      String    @id @default(uuid())
  accountId               String
  account                 Account   @relation(fields: [accountId], references: [id])
  campaignId              String?
  campaign                Campaign? @relation(fields: [campaignId], references: [id])
  cropId                  String?
  crop                    Crop?     @relation(fields: [cropId], references: [id])
  certificateFile         String?
  analysisNumber          String?
  grade                   String?
  electronicCertification Json?
  depositary              Json?
  depositor               Json?
  grossWeight             Float?
  netWeight               Float?
  mermaVolatile           Float?
  mermaDrying             Float?
  mermaScreening          Float?
  services                Json?
  creationDate            DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  transportLinks CertificateDepositTransport[]

  @@map("certificate_deposits")
}

model CertificateDepositTransport {
  id                  String             @id @default(uuid())
  certificateId       String
  certificate         CertificateDeposit @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  transportDocumentId String
  transportDocument   TransportDocument  @relation(fields: [transportDocumentId], references: [id])
  certificateNumber   String?
  billNumber          String?
  billDate            DateTime?
  netKg               Float?
  mermaScreeningKg    Float?
  screeningRate       Float?
  screeningAmount     Float?
  humidityDrying      Float?
  mermaDryingKg       Float?
  dryingRate          Float?
  dryingAmount        Float?
  createdAt           DateTime           @default(now())

  @@map("certificate_deposit_transports")
}

model CampaignExpense {
  id              String    @id @default(uuid())
  accountId       String
  account         Account   @relation(fields: [accountId], references: [id])
  campaignId      String?
  campaign        Campaign? @relation(fields: [campaignId], references: [id])
  fieldId         String?
  field           Field?    @relation(fields: [fieldId], references: [id])
  lotId           String?
  lot             FieldLot? @relation(fields: [lotId], references: [id])
  cropId          String?
  crop            Crop?     @relation(fields: [cropId], references: [id])
  hectares        Float?
  campaignName    String?
  zafra           String?
  fieldName       String?
  lotName         String?
  cropName        String?
  altCurrency     String?
  altCurrencyRate Float?
  isClosed        Boolean   @default(false)
  supplyLabors    Json?
  harvestLine     Json?
  serviceLabors   Json?
  machineryLabors Json?
  expenseDetails  Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("campaign_expenses")
}
