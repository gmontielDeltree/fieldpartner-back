# Server
PORT=4001
NODE_ENV=development

# CORS — comma-separated allow-list of frontend origins (no spaces required).
# Must match the dev/prod URLs of backoffice, frontend and license-manager.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# PostgreSQL — connection string format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fieldpartner_db?schema=public"

# AWS Cognito
AWS_REGION=us-east-1
AWS_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
AWS_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
