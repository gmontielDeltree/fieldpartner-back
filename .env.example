# Server
PORT=4001
NODE_ENV=development

# CORS — comma-separated allow-list of frontend origins (no spaces required).
# Must match the dev/prod URLs of backoffice, frontend and license-manager.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# PostgreSQL — connection string format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fieldpartner_db?schema=public"

# AWS Cognito
AWS_REGION=us-east-1
AWS_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
AWS_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
# Optional: one app client per frontend (no client secret, ADMIN_USER_PASSWORD_AUTH +
# REFRESH_TOKEN_AUTH enabled). When set, the channel of a token comes from its signed
# client_id and @Channels() is enforced. Unset → that channel uses AWS_COGNITO_CLIENT_ID.
AWS_COGNITO_CLIENT_ID_FIELDPARTNER_FRONT=
AWS_COGNITO_CLIENT_ID_LICENCE_FRONT=
AWS_COGNITO_CLIENT_ID_BACKOFFICE=
AWS_ACCESSKEYID=AKIAIOSFODNN7EXAMPLE
AWS_SECRETACCESSKEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
