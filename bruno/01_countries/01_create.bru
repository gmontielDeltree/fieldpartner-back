meta {
  name: Create Country
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/countries
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "code": "AR",
    "descriptionES": "Argentina",
    "descriptionPT": "Argentina",
    "descriptionEN": "Argentina",
    "language": "es",
    "currency": "ARS",
    "taxKey": "CUIT",
    "taxKeyFormat": "##-########-#"
  }
}
