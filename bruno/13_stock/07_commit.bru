meta {
  name: Commit grain (sale contract)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/crop-balances/commit
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "campaignId": "{{campaignId}}",
    "zafra": "gruesa_verano",
    "cropId": "{{cropId}}",
    "deltaKg": 10000
  }
}
