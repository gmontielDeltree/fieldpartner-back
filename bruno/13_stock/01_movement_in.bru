meta {
  name: Stock movement (inflow)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/stock-movements
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "itemType": "SUPPLY",
    "inputId": "{{inputId}}",
    "campaignId": "{{campaignId}}",
    "depositId": "{{depositId}}",
    "location": "A",
    "direction": "IN",
    "amount": 100,
    "unitMeasurement": "lt",
    "info": { "movementTypeId": "{{movementTypeId}}", "operationDate": "2026-11-27T10:00:00.000Z", "detail": "Bruno" }
  }
}
