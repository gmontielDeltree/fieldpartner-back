meta {
  name: Grain inflow (harvest)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/stock-movements
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "itemType": "CROP",
    "cropId": "{{cropId}}",
    "campaignId": "{{campaignId}}",
    "zafra": "gruesa_verano",
    "depositId": "{{depositId}}",
    "direction": "IN",
    "amount": 25000,
    "unitMeasurement": "kg",
    "fieldId": "{{fieldId}}",
    "lotId": "{{lotId}}",
    "info": { "movementTypeId": "{{movementTypeId}}", "operationDate": "2026-11-27T10:00:00.000Z", "detail": "Bruno" }
  }
}
